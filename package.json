{
  "name": "smartschool-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "npm install --prefix api && npm install --prefix web && npm run build", "build": "npm run build --prefix web && npm --prefix api run prisma:generate", "start": "npm --prefix api run start:prod",
    "dev": "npm run dev --prefix web",
    "dev:web": "npm run dev --prefix web",
    "dev:api": "npm run dev --prefix api",
    "prisma:studio": "npm run --prefix api prisma:studio",
    "studio": "npm run --prefix api prisma:studio",
    "install:all": "npm install --prefix api && npm install --prefix web",
    "build:web": "npm run build --prefix web",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f"
  }
}
